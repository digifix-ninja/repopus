{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Repopus",
  "version": "0.1.0",
  "identifier": "ninja.digifix.repopus",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Repopus",
        "width": 1040,
        "height": 700,
        "minWidth": 760,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "DigiFix S.à r.l.-S.",
    "copyright": "© 2026 DigiFix S.à r.l.-S. · MIT licence",
    "shortDescription": "Keeps local copies of GitHub repositories up to date",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
